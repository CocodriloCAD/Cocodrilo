<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net7.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>Cocodrilo</RootNamespace>
    <AssemblyName>Cocodrilo</AssemblyName>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <!-- Properties/AssemblyInfo.cs hand-writes AssemblyVersion("1.0.*"); keep it as the
         single source of assembly attributes (avoid SDK-generated duplicates), and disable
         determinism since the wildcard version is incompatible with deterministic builds. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- Rhino loads Cocodrilo.rhp directly (no apphost), so its NuGet dependencies
         (Newtonsoft.Json etc.) need to physically sit next to it in the output folder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net48'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Present on disk but never part of the original build (not in the legacy .csproj's
       explicit file list) - dead/stale code left over from an old "TeDaSharp" rename.
       Excluded here to match original compiled behavior; SDK-style implicit globbing would
       otherwise pull them in. -->
  <ItemGroup>
    <Compile Remove="Refinment.cs" />
    <Compile Remove="Commands\CommandDeletePointSupport.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
